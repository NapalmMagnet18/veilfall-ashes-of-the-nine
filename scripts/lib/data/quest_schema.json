{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Veilfall Quest Content v1",
  "type": "object",
  "required": [
    "id",
    "title",
    "kind",
    "zone_id",
    "required_level",
    "objective",
    "reward",
    "prerequisites"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(ORI|CLS|Z[0-9]{2})-"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "kind": {
      "enum": [
        "main",
        "side",
        "ancestry_origin",
        "class_initiation"
      ]
    },
    "zone_id": {
      "type": "string"
    },
    "required_level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    },
    "objective": {
      "type": "string"
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reward": {
      "type": "object"
    }
  }
}