# spawn-scene v2 yaml x0z1
cap-blossom-2:
  castShadow: true
  feetPosition: {x: 5.2, y: {terrain: 0}, z: 73}
  fx: {script: "fx\npop petal rate=?mobile:2|4 on=disc(1.6).c(3.2) life=5..8 v=sdir()*.15+<0,-.35,0> size=.035..0.06 acc=curl(.6)*.5+drag(.6) spin=-4..4 col=<1,.82,.86>..<1,.93,.9> a=0>.1:1>.8:1>0 sz=$size rot=$age*$spin floor=stick r=sprite(soft-disc,alpha)"}
  id: cap-blossom-2
  physics: none
  primitive: {kind: scripted, script: scripts/plants/emberblossom.js, seed: 25}
  rotation: 166
  scale: 1.25
  tags: [candlehold, flora]
cap-blossom-2/trunk:
  feetPosition: {x: 0, y: 0, z: 0}
  id: cap-blossom-2/trunk
  parent: cap-blossom-2
  physics: static
  primitive: {height: 2.6, kind: cylinder, radiusBottom: 0.3, radiusTop: 0.25}
  visible: false
