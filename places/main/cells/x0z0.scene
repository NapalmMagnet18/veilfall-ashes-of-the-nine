wayside-fire:
  feetPosition: {x: 0, y: {terrain: 0}, z: 0}
  fx: {script: "fx\npop coals n=16 on=disc(.38).c(.08) size=.07..0.16 tint=<2.6,1,.28>..<1.2,.35,.09> sz=$size*flick(.5,.12) col=$tint*flick(.8,.3) a=.9 r=sprite(soft-disc,add)\npop flame rate=flick(.45,.2)*95 on=disc(.3).c(.12) life=.55..1.05 v=up(1.9)+cone(24)*(.35..0.9) size=.3..0.55 acc=curl(.5)*1.3+buoy(2.4)+drag(1.5)\n  sz=$size*(.5>.25:1>.7:.72>.14) col=hdr(4.8,3.6,1.5)>.3:hdr(3.4,1.5,.35)>.65:hdr(1.9,.55,.12)>hdr(.7,.14,.03) a=0>.12:1>.75:.85>0 rot=spin(.2) r=sprite(flame-wisp,add)\npop embers rate=7 on=disc(.3).c(.2) life=.8..1.8 v=up(2.6)+cone(32)*(.4..1.3) size=.02..0.05 acc=curl(.8)*1.1+grav()*.45+drag(.5)\n  sz=$size*(1>.7:.8>.3) col=hdr(5,2.8,.8)>.6:hdr(2.4,.8,.15)>hdr(1,.22,.04) a=(0>.08:1>.65:.9>0)*flick(11,.35) r=sprite(ember,add,velocity,.02)\npop smoke on=@flame?.22 inh=p;v:$v*.4 life=2..3.6 size=.2..0.32 acc=buoy(.9)+curl(.35)*.5+drag(.8) sz=$size*(.7>3.6) col=<.3,.28,.26>><.15,.15,.16> a=0>.25:.3>.7:.21>0 rot=spin(.15) r=sprite(smoke-puff,alpha)\npop hearth n=1 at=disc(.22).c(.7) glo=fire()*(#flame/60)~ r=light(<1,.55,.24>,$glo*25,14)"}
  id: wayside-fire
  material: {pbr: true}
  physics: static
  primitive: {kind: scripted, params: {}, script: scripts/gen/hub-firepit.js, seed: 1}
  tags: [z01-dressing, hub]
