  ui: "<div face=\"front\" emissive width=\"0.9m\" class=\"text-center\" style=\"font-family:serif;padding:30px 10px\"><div style=\"font-size:64px;letter-spacing:12px;color:#C49C63\">THE NINE</div><div style=\"height:3px;background:#6DB8C0;opacity:.5;margin:12px 80px 18px\"></div><div style=\"font-size:54px;letter-spacing:6px;line-height:86px\"><span style=\"color:#bff4fa;text-shadow:0 0 18px #6DB8C0,0 0 40px #6DB8C0\">{{ state.on_bailiff }}</span><span style=\"color:#5a5c66\">{{ state.off_bailiff }}</span></div><div style=\"font-size:54px;letter-spacing:6px;line-height:86px\"><span style=\"color:#bff4fa;text-shadow:0 0 18px #6DB8C0,0 0 40px #6DB8C0\">{{ state.on_ringer }}</span><span style=\"color:#5a5c66\">{{ state.off_ringer }}</span></div><div style=\"font-size:54px;letter-spacing:6px;line-height:86px\"><span style=\"color:#bff4fa;text-shadow:0 0 18px #6DB8C0,0 0 40px #6DB8C0\">{{ state.on_warden }}</span><span style=\"color:#5a5c66\">{{ state.off_warden }}</span></div><div style=\"font-size:54px;letter-spacing:6px;line-height:86px\"><span style=\"color:#bff4fa;text-shadow:0 0 18px #6DB8C0,0 0 40px #6DB8C0\">{{ state.on_hangman }}</span><span style=\"color:#5a5c66\">{{ state.off_hangman }}</span></div><div style=\"font-size:54px;letter-spacing:6px;line-height:86px\"><span style=\"color:#bff4fa;text-shadow:0 0 18px #6DB8C0,0 0 40px #6DB8C0\">{{ state.on_abbess }}</span><span style=\"color:#5a5c66\">{{ state.off_abbess }}</span></div><div style=\"font-size:54px;letter-spacing:6px;line-height:86px\"><span style=\"color:#bff4fa;text-shadow:0 0 18px #6DB8C0,0 0 40px #6DB8C0\">{{ state.on_s6 }}</span><span style=\"color:#5a5c66\">{{ state.off_s6 }}</span></div><div style=\"font-size:54px;letter-spacing:6px;line-height:86px\"><span style=\"color:#bff4fa;text-shadow:0 0 18px #6DB8C0,0 0 40px #6DB8C0\">{{ state.on_s7 }}</span><span style=\"color:#5a5c66\">{{ state.off_s7 }}</span></div><div style=\"font-size:54px;letter-spacing:6px;line-height:86px\"><span style=\"color: